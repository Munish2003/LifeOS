# Application Settings
PROJECT_NAME="Personal AI Life OS"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production-use-random-bytes"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Settings (Defaults to SQLite for easy local offline/zero-config running, or PostgreSQL)
DATABASE_URL="sqlite+pysqlite:///./lifeos.db"
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/lifeos

# AI & External API Keys (Optional - deterministic features work without keys)
HUGGINGFACE_API_KEY=""
DEEPGRAM_API_KEY=""
AI_MODEL_NAME="meta-llama/Meta-Llama-3-8B-Instruct"

# Server Host
HOST="0.0.0.0"
PORT=8000
